{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@design/*": [
        "../design/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../design/**/*.ts"
  ]
}
