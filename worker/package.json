{
  "name": "zukai-worker",
  "version": "1.0.0",
  "type": "module",
  "description": "Zukai Fastify AI Audio Processing Worker (Gemini 1.5 + TTS)",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "eval": "tsx eval/runEval.ts",
    "eval:full": "tsx eval/evalRunner.ts",
    "eval:smoke": "tsx eval/evalRunner.ts --smoke",
    "eval:gate": "tsx eval/evalRunner.ts --gate",
    "feedback:report": "tsx src/scripts/feedbackReport.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "mammoth": "^1.8.0",
    "nodemon": "^3.1.14",
    "pdf-parse": "^1.1.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
